        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start(( )):::startNode\n    End((( ))):::endNode\n\n    %% LÀN KHÁCH HÀNG\n    subgraph KhachHang [Khách hàng]\n        A[Truy cập chức năng Đặt sân]\n        B[Chọn: Cụm sân, Sân con, Ngày đá, Khung giờ]\n        C[Nhấn nút &#39;Thanh toán ngay&#39; trong Giỏ hàng]\n    end\n\n    %% LÀN HỆ THỐNG\n    subgraph HeThong [Hệ thống]\n        D{Kiểm tra trạng thái&lt;br/&gt;Khung giờ còn trống?}\n        E[Thông báo lỗi: Sân đã bị&lt;br&gt;khách khác đặt hoặc đóng cửa]\n        \n        F[Tính toán Tiền cọc cần thanh toán&lt;br/&gt;30% (Phong trào) / 50% (Giải đấu)]\n        G{Kiểm tra Số dư ví&lt;br/&gt;&gt;= Tiền cọc?}\n        H[Thông báo lỗi: Số dư không đủ,&lt;br&gt;yêu cầu Nạp thêm tiền]\n        \n        I[Trừ tiền cọc trong Ví khách hàng&lt;br&gt;Ghi nhận Lịch sử giao dịch]\n        J[Lưu Đơn đặt sân vào CSDL&lt;br&gt;Trạng thái: DaCoc]\n        K[Phát Broadcast AdminDataUpdated&lt;br&gt;gọi Admin]\n        L[Hiển thị thông báo thành công&lt;br&gt;Cung cấp Mã vé điện tử]\n    end\n\n    %% Luồng đi\n    Start --&gt; A\n    A --&gt; B\n    B --&gt; C\n    C --&gt; D\n    \n    D --&gt;|Đã kẹt lịch| E\n    E --&gt; B\n    \n    D --&gt;|Còn trống| F\n    F --&gt; G\n    \n    G --&gt;|Không đủ tiền| H\n    H --&gt; End\n    \n    G --&gt;|Đủ tiền| I\n    I --&gt; J\n    J --&gt; K\n    K --&gt; L\n    L --&gt; End\n\n    %% CSS style\n    classDef startNode fill:#000,stroke:#000,stroke-width:2px;\n    classDef endNode fill:#fff,stroke:#000,stroke-width:4px;\n    style KhachHang fill:#f8fafc,stroke:#cbd5e1,stroke-width:2px,color:#1e293b,stroke-dasharray: 5 5\n    style HeThong fill:#f0fdf4,stroke:#86efac,stroke-width:2px,color:#166534,stroke-dasharray: 5 5&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="j_lN8UlWw-h3Vg0xlka--1">
