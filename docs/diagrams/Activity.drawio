        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start(( )):::startNode\n    End((( ))):::endNode\n\n    %% LÀN KHÁCH HÀNG\n    subgraph KhachHang [Khách hàng]\n        A[Truy cập trang Quên mật khẩu]\n        B[Nhập Email cần khôi phục]\n        F[Nhận Email chứa OTP 6 số]\n        G[Nhập mã OTP và Mật khẩu mới]\n    end\n\n    %% LÀN HỆ THỐNG\n    subgraph HeThong [Hệ thống]\n        C{Kiểm tra Email&lt;br&gt;tồn tại trong DB?}\n        D[Báo lỗi: Email không tồn tại]\n        E[Tạo OTP 6 số ngẫu nhiên&lt;br&gt;Lưu DB kèm hạn sử dụng 5 phút]\n        E_Mail[Gửi mã OTP qua hệ thống Email]\n        \n        H{OTP khớp và&lt;br&gt;Còn trong hạn 5 phút?}\n        I[Báo lỗi: Mã sai hoặc Hết hạn]\n        J[Mã hóa Mật khẩu mới lưu vào DB&lt;br&gt;Xóa dữ liệu OTP cũ]\n        K[Hiển thị thông báo thành công]\n    end\n\n    %% Luồng đi\n    Start --&gt; A\n    A --&gt; B\n    B --&gt; C\n    \n    C --&gt;|Không tồn tại| D\n    D --&gt; B\n    \n    C --&gt;|Tồn tại| E\n    E --&gt; E_Mail\n    E_Mail --&gt; F\n    F --&gt; G\n    G --&gt; H\n    \n    H --&gt;|Không hợp lệ| I\n    I --&gt; G\n    \n    H --&gt;|Hợp lệ| J\n    J --&gt; K\n    K --&gt; End\n\n    %% CSS style\n    classDef startNode fill:#000,stroke:#000,stroke-width:2px;\n    classDef endNode fill:#fff,stroke:#000,stroke-width:4px;\n    style KhachHang fill:#f8fafc,stroke:#cbd5e1,stroke-width:2px,color:#1e293b,stroke-dasharray: 5 5\n    style HeThong fill:#f0fdf4,stroke:#86efac,stroke-width:2px,color:#166534,stroke-dasharray: 5 5&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vaVM7y3IgWU_5dioBud7-1">
