        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start(( )):::startNode\n    End((( ))):::endNode\n\n    %% LÀN ADMIN\n    subgraph Admin [Admin]\n        A[Mở danh sách Yêu cầu Hủy gấp]\n        B[Xem xét lý do của Khách hàng]\n        C{Ra quyết định xử lý?}\n        \n        C1[Chọn: Duyệt Hủy]\n        C2[Chọn: Từ chối Hủy&lt;br&gt;Nhập lý do từ chối]\n    end\n\n    %% LÀN HỆ THỐNG\n    subgraph HeThong [Hệ thống]\n        D1[Cập nhật YeuCau = DaDuyet]\n        D1_1[Cập nhật DatSan = DaHuy]\n        D1_2[Tự động cộng tiền hoàn cọc&lt;br&gt;vào Số dư ví Khách hàng]\n        D1_3[Ghi nhận Lịch sử giao dịch]\n        \n        D2[Cập nhật YeuCau = TuChoi&lt;br&gt;Giữ nguyên vé DatSan là &#39;DaCoc&#39;]\n        \n        E[Tạo ThongBao lưu vào DB]\n        F[Phát Broadcast UserDataUpdated&lt;br&gt;để Khách hàng nhận kết quả]\n    end\n\n    %% Luồng đi\n    Start --&gt; A\n    A --&gt; B\n    B --&gt; C\n    \n    C --&gt;|Đồng ý hoàn tiền| C1\n    C1 --&gt; D1\n    D1 --&gt; D1_1\n    D1_1 --&gt; D1_2\n    D1_2 --&gt; D1_3\n    D1_3 --&gt; E\n    \n    C --&gt;|Lý do không chính đáng| C2\n    C2 --&gt; D2\n    D2 --&gt; E\n    \n    E --&gt; F\n    F --&gt; End\n\n    %% CSS style\n    classDef startNode fill:#000,stroke:#000,stroke-width:2px;\n    classDef endNode fill:#fff,stroke:#000,stroke-width:4px;\n    style Admin fill:#fff7ed,stroke:#fdba74,stroke-width:2px,color:#9a3412,stroke-dasharray: 5 5\n    style HeThong fill:#f0fdf4,stroke:#86efac,stroke-width:2px,color:#166534,stroke-dasharray: 5 5&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="I77GTgZY0OKutt2KWjOt-1">
