  <diagram id="Hy6ND-FdDLdeTJ29Iyc7" name="Hủy sân">
    <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor U as Khách hàng\n    participant UI as Giao diện Lịch sử\n    participant C as HuySanController\n    participant DB as Database\n    participant WS as WebSockets\n\n    U-&gt;&gt;UI: Chọn lịch đặt và nhấn \&quot;Hủy sân\&quot;\n    UI-&gt;&gt;C: POST /api/huy-san (ticket_id)\n    C-&gt;&gt;DB: getTicket(ticket_id)\n    DB--&gt;&gt;C: Lấy thông tin vé (Giờ đá)\n\n    C-&gt;&gt;C: Tính toán (Giờ đá - Thời gian hiện tại)\n    alt Vi phạm thời gian an toàn (&lt;= 10 tiếng)\n        C--&gt;&gt;UI: Lỗi \&quot;Quá hạn hủy tự động, vui lòng dùng Hủy gấp\&quot;\n        UI--&gt;&gt;U: Hiển thị cảnh báo\n    else Hợp lệ (&gt; 10 tiếng)\n        C-&gt;&gt;C: Bắt đầu Transaction\n        C-&gt;&gt;DB: updateTicket(status: &#39;DaHuy&#39;)\n        C-&gt;&gt;DB: addWalletBalance(user_id, tien_coc)\n        C-&gt;&gt;DB: createTransactionHistory()\n        C-&gt;&gt;C: Commit Transaction\n        \n        C-&gt;&gt;WS: broadcast(AdminDataUpdated)\n        C--&gt;&gt;UI: Thông báo \&quot;Hủy và hoàn tiền thành công\&quot;\n        UI--&gt;&gt;U: Làm mới danh sách vé\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zn4tZ7QRHAqFC33spH96-1">
