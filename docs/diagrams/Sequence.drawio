  <diagram id="Aku8xm97ARP_1e3W8NOB" name="Đặt sân">
    <mxGraphModel dx="2805" dy="1295" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor U as Khách hàng\n    participant UI as Giao diện Giỏ hàng\n    participant C as DatSanController\n    participant DB as Database\n    participant WS as WebSockets (Reverb)\n\n    U-&gt;&gt;UI: Chọn sân, giờ đá và nhấn \&quot;Thanh toán ngay\&quot;\n    UI-&gt;&gt;C: POST /api/dat-san (san_id, gio_bat_dau)\n    \n    C-&gt;&gt;DB: checkAvailable(san_id, gio_bat_dau)\n    DB--&gt;&gt;C: Kết quả (Trống / Bị kẹt)\n    \n    alt Sân đã bị người khác đặt\n        C--&gt;&gt;UI: Lỗi \&quot;Khung giờ đã được đặt\&quot;\n        UI--&gt;&gt;U: Hiển thị thông báo đỏ\n    else Sân hợp lệ\n        C-&gt;&gt;DB: checkBalance(user_id)\n        DB--&gt;&gt;C: Số dư Ví\n        \n        alt Số dư &lt; Tiền cọc (30%)\n            C--&gt;&gt;UI: Lỗi \&quot;Số dư ví không đủ\&quot;\n            UI--&gt;&gt;U: Yêu cầu nạp thêm tiền\n        else Số dư &gt;= Tiền cọc\n            C-&gt;&gt;C: Bắt đầu Transaction\n            C-&gt;&gt;DB: deductWallet(user_id, tien_coc)\n            C-&gt;&gt;DB: createDatSan(data, status: &#39;DaCoc&#39;)\n            C-&gt;&gt;C: Commit Transaction\n            \n            C-&gt;&gt;WS: broadcast(NewBookingEvent)\n            WS--&gt;&gt;UI: Đồng bộ UI Admin &amp; Khách khác\n            C--&gt;&gt;UI: Trả về Mã vé điện tử\n            UI--&gt;&gt;U: Chuyển sang màn hình Thành công\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="b3FhIWS-o3jDX3IRSo8n-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Khách hàng" mermaidId="n:U" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Khách hàng" id="b3FhIWS-o3jDX3IRSo8n-2">
