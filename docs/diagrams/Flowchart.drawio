      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    Start([Bắt đầu Chốt lịch]) --&gt; Step1[Admin mở màn hình&lt;br&gt;Quản lý Đặt Sân (Lọc trạng thái DaCoc)]\n    Step1 --&gt; Step2[Admin nhấn nút &#39;Chốt sân&#39;&lt;br&gt;cho một mã vé cụ thể]\n    Step2 --&gt; Cond1{Admin chọn&lt;br&gt;Trạng thái xử lý nào?}\n    \n    %% Nhánh 1: Hoàn thành\n    Cond1 --&gt;|Hoàn thành| Action1[Thu nốt phần tiền còn lại&lt;br&gt;(Giao dịch ngoài hệ thống)]\n    Action1 --&gt; DB1[Cập nhật trạng thái vé = HoanThanh]\n    \n    %% Nhánh 2: Không đến (Bùng sân)\n    Cond1 --&gt;|Không đến| Action2[Ghi nhận Khách bùng sân&lt;br&gt;Tiền cọc bị hệ thống thu hồi]\n    Action2 --&gt; DB2[Cập nhật trạng thái vé = KhongDen&lt;br&gt;Cộng 1 điểm &#39;bùng sân&#39; vào hồ sơ Khách]\n    \n    %% Nhánh 3: Hủy &amp; Hoàn tiền\n    Cond1 --&gt;|Hủy &amp; Hoàn tiền| Action3[Hệ thống tự động trả lại&lt;br&gt;100% tiền cọc vào Ví khách hàng]\n    Action3 --&gt; DB3[Cập nhật trạng thái vé = DaHuy&lt;br&gt;Ghi nhận Lịch sử giao dịch cộng tiền]\n    \n    %% Gom chung về kết quả\n    DB1 --&gt; Result[Lưu Data &amp; Trả kết quả thành công]\n    DB2 --&gt; Result\n    DB3 --&gt; Result\n    \n    Result --&gt; UpdateUI[Admin UI tự động load lại dữ liệu&lt;br&gt;không cần F5 (syncTongQuanData)]\n    UpdateUI --&gt; End([Hoàn tất xử lý vé])&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6GZMWxMFPgmI8vRY6np4-1">
